# Copier en .env.local et remplir avec les valeurs du projet Supabase (Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Serveur uniquement : clé secrète Supabase (Settings > API Keys > Secret keys).
SUPABASE_SECRET_KEY=sb_secret_...
# Adresses autorisées à créer des entreprises, séparées par des virgules.
ADMIN_EMAILS=vous@exemple.fr

# Lot 2, serveur uniquement. Sans ces clés, les adresses se saisissent à la main et l'ordre n'est pas calculé.
# Lecture des photos d'étiquettes : clé de l'API Claude (console Anthropic).
ANTHROPIC_API_KEY=
# Ordre de passage : contenu du fichier JSON de la clé d'un compte de service Google Cloud
# (API « Route Optimization » activée, rôle « Route Optimization Editor »), sur une seule ligne.
GOOGLE_SERVICE_ACCOUNT_JSON=
