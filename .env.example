# Copier en .env.local et remplir avec les valeurs du projet Supabase (Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Serveur uniquement : clé secrète Supabase (Settings > API Keys > Secret keys).
SUPABASE_SECRET_KEY=sb_secret_...
# Adresses autorisées à créer des entreprises, séparées par des virgules.
ADMIN_EMAILS=vous@exemple.fr

# Lot 2, serveur uniquement. Sans ces clés, les adresses se saisissent à la main et l'ordre n'est pas calculé.
# Lecture des photos d'étiquettes : clé de l'API Claude (console Anthropic).
ANTHROPIC_API_KEY=
# Ordre de passage (Google Route Optimization), sans fichier de clé : Vercel prouve l'identité de Bonii (OIDC)
# et Google le laisse agir comme le compte de service (pool et fournisseur d'identité d'ID « vercel »).
# Ne marche que sur Vercel. Valeurs non secrètes.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
